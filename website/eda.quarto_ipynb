      "source": [
        "plt.figure(figsize=(10, 6))\n",
        "sns.boxplot(\n",
        "    data=merged_data, \n",
        "    x='mortality_category', \n",
        "    y='firearm_mortality_rate_children_one_to_nine_years_old', \n",
        "    palette=refined_palette,\n",
        "    width=0.6\n",
        ")\n",

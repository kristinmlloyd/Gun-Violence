  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        " ---\n",
        "title: \"\"\n",
        "author: “Kristin Lloyd”\n",
        "format: \n",
        "  html:\n",
        "    css: styles.css\n",
        "    embed-resources: true\n",
        "    code-fold: true\n",
        "\n",
        "---\n"
      ],
      "id": "bc95e19f"
    },
    {
      "cell_type": "code",
      "metadata": {
        "fig-width": 2,
        "fig-height": 2
      },
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import pandas as pd\n",
        "\n",
        "# Load the datasets\n",
        "merged_data = pd.read_csv(\"data/merged_data.csv\")\n",
        "\n",
        "merged_data.head()"
      ],
      "id": "c26b4541",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Professional, elegant color palette (vibrant but slightly muted)\n",
        "refined_palette = {\n",
        "    \"Very Low\": \"#3b8ea5\",     # rich teal blue\n",
        "    \"Low\": \"#7ec4cf\",          # soft muted aqua\n",
        "    \"Moderate\": \"#f4d35e\",     # sophisticated yellow-gold\n",
        "    \"High\": \"#ee964b\",         # warm muted orange\n",
        "    \"Very High\": \"#d1495b\"     # elegant deep red\n",
        "}\n",
        "# Prettify category names\n",
        "category_labels = {\n",
        "    \"national_failures\": \"National Failures\",\n",
        "    \"weak_systems\": \"Weak Systems\",\n",
        "    \"making_progress\": \"Making Progress\",\n",
        "    \"missing_key_laws\": \"Missing Key Laws\",\n",
        "    \"national_leader\": \"National Leader\"\n",
        "}\n",
        "\n",
        "# Vibrant, exciting palette (high-contrast but tasteful)\n",
        "vibrant_palette = {\n",
        "    \"national_failures\": \"#d73027\",  # vivid red\n",
        "    \"weak_systems\": \"#fc8d59\",       # bright coral\n",
        "    \"making_progress\": \"#fee08b\",    # golden yellow\n",
        "    \"missing_key_laws\": \"#91bfdb\",   # light vibrant blue\n",
        "    \"national_leader\": \"#4575b4\"     # deep vivid blue\n",
        "}\n",
        "\n",
        "# Ensure order\n",
        "merged_data['gun_law_strength'] = pd.Categorical(\n",
        "    merged_data['gun_law_strength'], \n",
        "    categories=[\"national_failures\", \"weak_systems\", \"making_progress\", \"missing_key_laws\", \"national_leader\"],\n",
        "    ordered=True\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(11, 6))\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "ax = sns.boxplot(\n",
        "    x=\"gun_law_strength\",\n",
        "    y=\"firearm_mortality_by_state_2022\",\n",
        "    data=merged_data,\n",
        "    order=[\"national_failures\", \"weak_systems\", \"making_progress\", \"missing_key_laws\", \"national_leader\"],\n",
        "    palette=vibrant_palette,\n",
        "    linewidth=1.8,\n",
        "    fliersize=3,\n",
        "    boxprops=dict(alpha=0.9, linewidth=1.5),\n",
        "    whiskerprops=dict(linewidth=1.4),\n",
        "    capprops=dict(linewidth=1.4),\n",
        "    medianprops=dict(color=\"black\", linewidth=2)\n",
        ")\n",
        "\n",
        "# Update the tick labels to proper format without rotation\n",
        "ax.set_xticklabels([category_labels[label.get_text()] for label in ax.get_xticklabels()], fontsize=13)\n",
        "\n",
        "# Labeling\n",
        "plt.xlabel(\"Gun Law Strength Category\", fontsize=15, labelpad=10)\n",
        "plt.ylabel(\"Firearm Mortality Rate (2022)\", fontsize=15, labelpad=10)\n",
        "plt.title(\"Firearm Mortality Rates by Gun Law Strength\", fontsize=20, weight='bold', pad=20)\n",
        "\n",
        "# Subtle gridlines\n",
        "plt.grid(axis=\"y\", linestyle=\"--\", alpha=0.25)\n",
        "\n",
        "# Add median annotations on each box\n",
        "medians = merged_data.groupby(\"gun_law_strength\")[\"firearm_mortality_by_state_2022\"].median()\n",
        "for i, median in enumerate(medians):\n",
        "    ax.text(i, median + 0.5, f\"{median:.1f}\", ha='center', fontsize=11, weight='bold', color=\"black\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "1cb4b768",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Define bins and categories (if not already done)\n",
        "bins = [0, 10, 15, 20, 25, merged_data['firearm_mortality_by_state_2022'].max()]\n",
        "labels = [\"Very Low\", \"Low\", \"Moderate\", \"High\", \"Very High\"]\n",
        "merged_data['mortality_category'] = pd.cut(\n",
        "    merged_data['firearm_mortality_by_state_2022'], bins=bins, labels=labels\n",
        ")\n",
        "\n",
        "# Vibrant eye-catching palette (progressing from cool green to deep red-purple)\n",
        "vibrant_mortality_palette = {\n",
        "    \"Very Low\": \"#2a9d8f\",     # teal\n",
        "    \"Low\": \"#8ecae6\",          # soft sky blue\n",
        "    \"Moderate\": \"#f9c74f\",     # vivid yellow\n",
        "    \"High\": \"#f9844a\",         # vibrant orange\n",
        "    \"Very High\": \"#d00000\"     # deep red\n",
        "}\n",
        "\n",
        "plt.figure(figsize=(11, 6))\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "ax = sns.boxplot(\n",
        "    data=merged_data, \n",
        "    x='mortality_category', \n",
        "    y='drug_overdose_mortality_rate', \n",
        "    palette=vibrant_mortality_palette,\n",
        "    linewidth=1.8,\n",
        "    fliersize=3,\n",
        "    boxprops=dict(alpha=0.9, linewidth=1.5),\n",
        "    whiskerprops=dict(linewidth=1.4),\n",
        "    capprops=dict(linewidth=1.4),\n",
        "    medianprops=dict(color=\"black\", linewidth=2)\n",
        ")\n",
        "\n",
        "# Clean and larger axis labels with no rotation\n",
        "ax.set_xticklabels([label for label in labels], fontsize=13)\n",
        "plt.xlabel(\"Firearm Mortality Category\", fontsize=15, labelpad=10)\n",
        "plt.ylabel(\"Drug Overdose Mortality Rate (per 100,000)\", fontsize=15, labelpad=10)\n",
        "plt.title(\"Drug Overdose Mortality Rate by Firearm Mortality Category\", fontsize=20, weight='bold', pad=20)\n",
        "\n",
        "# Light grid lines for clarity\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.25)\n",
        "\n",
        "# Add median annotations\n",
        "medians = merged_data.groupby('mortality_category')['drug_overdose_mortality_rate'].median()\n",
        "for i, median in enumerate(medians):\n",
        "    ax.text(i, median + 0.5, f\"{median:.1f}\", ha='center', fontsize=11, weight='bold', color=\"black\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "20ef7124",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Reuse the vibrant color palette from before\n",
        "vibrant_mortality_palette = {\n",
        "    \"Very Low\": \"#2a9d8f\",     # teal\n",
        "    \"Low\": \"#8ecae6\",          # soft sky blue\n",
        "    \"Moderate\": \"#f9c74f\",     # vivid yellow\n",
        "    \"High\": \"#f9844a\",         # vibrant orange\n",
        "    \"Very High\": \"#d00000\"     # deep red\n",
        "}\n",
        "\n",
        "plt.figure(figsize=(11, 6))\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "ax = sns.boxplot(\n",
        "    data=merged_data, \n",
        "    x='mortality_category', \n",
        "    y='state_ranking_in_mental_health_in_adults', \n",
        "    palette=vibrant_mortality_palette,\n",
        "    width=0.6,\n",
        "    linewidth=1.8,\n",
        "    fliersize=3,\n",
        "    boxprops=dict(alpha=0.9, linewidth=1.5),\n",
        "    whiskerprops=dict(linewidth=1.4),\n",
        "    capprops=dict(linewidth=1.4),\n",
        "    medianprops=dict(color=\"black\", linewidth=2)\n",
        ")\n",
        "\n",
        "# Clean, readable axis labels with no rotation\n",
        "ax.set_xticklabels([label for label in labels], fontsize=13)\n",
        "\n",
        "# Labels and title\n",
        "plt.xlabel(\"Firearm Mortality Category\", fontsize=15, labelpad=10)\n",
        "plt.ylabel(\"State Ranking in Mental Health (Lower is Better)\", fontsize=15, labelpad=10)\n",
        "plt.title(\"State Ranking in Mental Health (Adults) by Firearm Mortality Category\", fontsize=20, weight='bold', pad=20)\n",
        "\n",
        "# Subtle grid lines for clarity\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.25)\n",
        "\n",
        "# Add median annotations for easy interpretation\n",
        "medians = merged_data.groupby('mortality_category')['state_ranking_in_mental_health_in_adults'].median()\n",
        "for i, median in enumerate(medians):\n",
        "    ax.text(i, median + 0.5, f\"{median:.1f}\", ha='center', fontsize=11, weight='bold', color=\"black\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "a55c022a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "plt.figure(figsize=(12, 6))\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "\n",
        "ax = sns.boxplot(\n",
        "    data=merged_data, \n",
        "    x='mortality_category', \n",
        "    y='state_ranking_in_mental_health_in_youth', \n",
        "    palette=refined_palette,\n",
        "    width=0.5,\n",
        "    linewidth=1.5,\n",
        "    fliersize=2.5,\n",
        "    boxprops=dict(alpha=0.9, linewidth=1.4),\n",
        "    whiskerprops=dict(linewidth=1.3),\n",
        "    capprops=dict(linewidth=1.3),\n",
        "    medianprops=dict(color=\"black\", linewidth=2)\n",
        ")\n",
        "\n",
        "ax.set_xticklabels([label for label in labels], fontsize=14)\n",
        "\n",
        "plt.title(\"State Ranking in Youth Mental Health by Firearm Mortality Category\", fontsize=22, weight='bold', pad=22)\n",
        "plt.xlabel(\"Firearm Mortality Category\", fontsize=16, labelpad=12)\n",
        "plt.ylabel(\"State Ranking (Lower is Better)\",weight='bold', fontsize=16, labelpad=12)\n",
        "\n",
        "plt.grid(axis='y', linestyle=\"--\", linewidth=0.7, alpha=0.25)\n",
        "\n",
        "medians = merged_data.groupby('mortality_category')['state_ranking_in_mental_health_in_youth'].median()\n",
        "for i, median in enumerate(medians):\n",
        "    ax.text(i, median + 1, f\"{median:.0f}\", ha='center', fontsize=11, weight='bold', color=\"black\")\n",
        "\n",
        "sns.despine()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "d78f2103",
      "execution_count": null,
      "outputs": []

      "source": [
        "plt.figure(figsize=(10, 6))\n",
        "sns.boxplot(\n",
        "    data=merged_data, \n",
        "    x='mortality_category', \n",
        "    y='dv_spending_per_person', \n",
        "    palette=palette,\n",
        "    width=0.6\n",

      "source": [
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "# Improved histogram with better labels and styling\n",
        "sns.histplot(\n",
        "    data=merged_data, \n",
        "    x=\"asault_weapons_prohibited\", \n",
        "    hue=\"mortality_category\", \n",
        "    multiple=\"fill\", \n",
        "    shrink=0.8, \n",
        "    palette=palette,\n",
        "    edgecolor=\"white\"\n",
        ")\n",
        "\n",
        "# Title and labels\n",
        "plt.title(\"Proportion of States by Firearm Mortality Level\\nand Assault Weapons Prohibition Policy\", fontsize=16, weight='bold')\n",
        "plt.xlabel(\"Assault Weapons Prohibited (0 = No, 1 = Yes)\", fontsize=13)\n",
        "plt.ylabel(\"Proportion of States\", fontsize=13)\n",
        "\n",
        "# Customize ticks and grid\n",
        "plt.xticks([0, 1], labels=[\"No\", \"Yes\"], fontsize=11)\n",
        "plt.yticks(fontsize=11)\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.5)\n",
        "\n",
        "# Enhanced legend\n",
        "plt.legend(title=\"Firearm Mortality Level\", title_fontsize=12, fontsize=11, loc=\"upper right\", frameon=True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "8628c12b",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from matplotlib.patches import Patch\n",
        "\n",
        "# Plot setup\n",
        "plt.figure(figsize=(10, 6))\n",
        "ax = sns.histplot(\n",
        "    data=merged_data, \n",
        "    x=\"asault_weapons_prohibited\", \n",
        "    hue=\"mortality_category\", \n",
        "    multiple=\"fill\", \n",
        "    element=\"bars\",\n",
        "    palette=custom_mortality_palette,\n",
        "    edgecolor=\"white\",\n",
        "    binwidth=1,            # full-width bar per category\n",
        "    binrange=(0, 2),       # ensures bars are centered at 0 and 1\n",
        "    shrink=0.9             # slight shrink for spacing\n",
        ")\n",
        "\n",
        "# Titles and axis labels\n",
        "plt.title(\"Firearm Mortality Rates by Assault Weapons Prohibition Policy\", fontsize=16, weight='bold')\n",
        "plt.xlabel(\"\")  # Remove label text\n",
        "plt.ylabel(\"Proportion of States\", fontsize=13)\n",
        "\n",
        "# Custom tick labels centered under bars\n",
        "ax.set_xticks([0, 1])\n",
        "ax.set_xticklabels([\"No\", \"Yes\"], fontsize=12)\n",
        "\n",
        "# Y ticks\n",
        "plt.yticks(fontsize=11)\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.5)\n",
        "\n",
        "# Custom legend\n",
        "legend_elements = [\n",
        "    Patch(facecolor=\"#68bb59\", label=\"Very Low\"),\n",
        "    Patch(facecolor=\"#acdf87\", label=\"Low\"),\n",
        "    Patch(facecolor=\"#fab733\", label=\"Moderate\"),\n",
        "    Patch(facecolor=\"#ff6242\", label=\"High\"),\n",
        "    Patch(facecolor=\"#c61a09\", label=\"Very High\"),\n",
        "]\n",
        "plt.legend(\n",
        "    handles=legend_elements,\n",
        "    title=\"Firearm Mortality Level\",\n",
        "    title_fontsize=12,\n",
        "    fontsize=11,\n",
        "    loc=\"upper center\",\n",
        "    bbox_to_anchor=(0.5, -0.15),\n",
        "    ncol=3,\n",
        "    frameon=False\n",
        ")\n",
        "\n",
        "# Adjust spacing\n",
        "plt.tight_layout()\n",
        "plt.subplots_adjust(bottom=0.2)\n",
        "plt.show()"
      ],
      "id": "4bb577ca",
      "execution_count": null,
      "outputs": []
    },
